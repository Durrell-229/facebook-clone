# ===== Supabase (obligatoire) =====
# Projet : https://supabase.com/dashboard
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon

# ===== OAuth (obligatoire pour GitHub/Google) =====
# Configurés dans le dashboard Supabase > Authentication > Providers

# ===== Syntax AI (assistant IA) =====
# Secrets de l'edge function supabase/functions/syntax-ai :
#   AI_API_KEY   — clé API du fournisseur IA (OpenAI, Mistral, Groq, OpenRouter…)
#   AI_BASE_URL  — ex. https://api.openai.com/v1  (compatible OpenAI)
#   AI_MODEL     — ex. gpt-4o-mini | mistral-small-latest | groq/llama-3.1-70b
# Déployer : supabase functions deploy syntax-ai

# ===== Synchronisation des flux (edge function sync-feeds) =====
# Optionnel : token GitHub pour augmenter le quota API côté serveur
GITHUB_TOKEN=ghp_votre_token
# Sources publiques (sans clé) : Dev.to, Reddit, Hacker News, Stack Overflow,
# Hashnode, Lobste.rs. Endpoints par défaut intégrés, surchargeables :
VITE_DEVTO_API_URL=https://dev.to/api
VITE_REDDIT_API_URL=https://www.reddit.com

# ===== Assets fournis par l'utilisateur =====
# Déposer vos images dans public/assets/ (chemin par défaut) :
#   public/assets/landing-bg.jpg  → image de fond de la landing page
#   public/assets/icon.png        → icône du projet (favicon + logo)
# Ou pointer vers une URL distante via :
# VITE_LANDING_BG_URL=https://…/fond.jpg
# VITE_APP_ICON_URL=https://…/icone.png
